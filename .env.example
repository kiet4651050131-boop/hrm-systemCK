PORT=3000
# Bat buoc doi: chuoi ngau nhien dai >= 32 ky tu (vd: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
# production: bat buoc co JWT_SECRET
NODE_ENV=development
# Duong dan file CSDL (mac dinh ./data/hrm.db)
DB_FILE=
# Mui gio dung cho cham cong (mac dinh Asia/Ho_Chi_Minh)
TZ=Asia/Ho_Chi_Minh
# SMTP gui email khoi phuc mat khau (Gmail can dung App Password)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@example.com
APP_URL=http://localhost:3000
